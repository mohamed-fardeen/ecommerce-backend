# MongoDB Connection Strings
DB_URI=mongodb+srv://username:password@cluster.mongodb.net/react-shop?retryWrites=true&w=majority
DB_URI_LOCATION=mongodb+srv://username:password@cluster.mongodb.net/location_db?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
TOKEN_KEY=your-token-key-here

# Server Port (optional, Render sets this automatically)
PORT=3001
